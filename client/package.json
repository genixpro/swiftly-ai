{
  "name": "swiftly-ai-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "check:bundle": "node scripts/check-web-bundle-size.mjs",
    "check:boundaries": "node scripts/check-frontend-boundaries.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test e2e/local-demo.spec.js",
    "test:visual": "playwright test e2e/visual-parity.spec.ts --project=chromium",
    "test:visual:update": "playwright test e2e/visual-parity.spec.ts --project=chromium --update-snapshots",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.production.json",
    "postinstall-heroku": "npm run build"
  },
  "browserslist": [
    "last 3 Chrome versions",
    "last 3 Edge versions",
    "last 3 Firefox versions",
    "last 3 Safari versions"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@tanstack/react-query": "^5.102.8",
    "axios": "1.20.0",
    "bootstrap": "5.3.8",
    "date-fns": "4.4.0",
    "google-map-react": "2.2.5",
    "i18next": "26.4.0",
    "i18next-http-backend": "3.0.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "20.1.1",
    "react-i18next": "17.0.12",
    "react-number-format": "5.4.5",
    "react-router": "8.3.1",
    "react-select": "5.10.2",
    "reactstrap": "9.2.3",
    "underscore": "1.13.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "10.9.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "sass": "1.103.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
